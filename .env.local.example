# Supabase — from your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Creates and emails accounts for invitations; never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Claude — the coding and synthesis passes
ANTHROPIC_API_KEY=

# Google Drive (Meet transcripts). See "Connecting Google Meet" in the README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts stored Google refresh tokens: `openssl rand -base64 32`. Keep it
# secret, and the same everywhere that shares a database; changing it
# disconnects everyone.
CONNECTOR_TOKEN_KEY=

# Where the app is served. Locally both can stay empty. In production:
#   SITE_URL=https://tools.harringtondata.com
#   NEXT_PUBLIC_BASE_PATH=/interview-synthesis
SITE_URL=
NEXT_PUBLIC_BASE_PATH=

# Time zone for dates shown by the server (Vercel runs on UTC). Default America/New_York.
NEXT_PUBLIC_TIME_ZONE=
